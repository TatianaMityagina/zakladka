# --- Провайдер ИИ: openrouter (по умолчанию) или anthropic ---
LLM_PROVIDER=

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# Модель для разбора глав (много вызовов — можно дешевле или бесплатно: google/gemma-4-31b-it:free)
DIGEST_MODEL=anthropic/claude-haiku-5.5
LLM_MAX_TOKENS=1500

# Anthropic напрямую: console.anthropic.com → API Keys (баланс отдельный от подписки claude.ai)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_DIGEST_MODEL=claude-haiku-5-5
# low | medium | high — глубина рассуждений
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000

# mock — без LLM (проверка разбора книги и поиска)
LLM_MODE=
PORT=3002
